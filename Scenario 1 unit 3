import csv

patients = []

with open("patients.csv", "r") as file:
    reader = csv.DictReader(file)
    for row in reader:
        patients.append(row)

print("Patient Records:")
for patient in patients:
    print(patient)

patient_id = input("Enter Patient ID to search: ")

found = False

for patient in patients:
    if patient["Patient ID"] == patient_id:
        print("Patient Found:")
        print("Patient ID:", patient["Patient ID"])
        print("Name:", patient["Name"])
        print("Treatment Cost:", patient["Treatment Cost"])
        print("Category:", patient["Category"])
        found = True
        break

if not found:
    print("Patient not found")
